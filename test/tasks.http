@baseUrl = http://localhost:3000/api/v1/tasks
@id = REEMPLAZAR_ID_TAREA
@token = REEMPLAZAR_TOKEN

### Listar tareas
GET {{baseUrl}}
Accept: application/json
Authorization: Bearer {{token}}

### Filtrar tareas pendientes
GET {{baseUrl}}?status=pending
Accept: application/json

### Crear tarea: 201
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Tarea de Ana",
  "priority": "high"
}

### Obtener tarea
GET {{baseUrl}}/{{id}}
Accept: application/json
Authorization: Bearer {{token}}

### Actualizar tarea
PATCH {{baseUrl}}/{{id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "done"
}

### Estado inválido: 400
PATCH {{baseUrl}}/{{id}}
Content-Type: application/json

{
  "status": "invalido"
}

### Campo no permitido: 400
PATCH {{baseUrl}}/{{id}}
Content-Type: application/json

{
  "ownerId": "000000000000000000000000"
}

### Eliminar tarea: 204
DELETE {{baseUrl}}/{{id}}
